# Copy to .env before `docker compose up`.

# --- Local LLM (Ollama) ---
OLLAMA_MODEL=llama3.2:1b
# 0.1 = near-deterministic (verified reliable in testing). Ollama's own
# default (0.8) makes the same prompt succeed or fail at random, which is
# confusing in a ladder where a level is supposed to be reliably solvable
# once you've found the right technique.
OLLAMA_TEMPERATURE=0.1
# How long the app waits for a single reply before giving up (seconds).
# 300s gives plenty of headroom on a CPU-only host under memory pressure.
OLLAMA_TIMEOUT=300

# --- Flag secrets, one per level (Level 6, the bonus level, has no flag) ---
# Change these per cohort/run so answers can't be copy-pasted from a
# previous run's writeup. Each becomes LAB{<value>} inside the app.
FLAG_CH1=staff_0verride_7f3a
FLAG_CH2=555_0142_priya
FLAG_CH3=excessive_agency_caught
FLAG_CH4=supply_chain_pwned
FLAG_CH5=mega90_vendor_code
FLAG_L5=shift_change_b71c9
FLAG_CH7=confidently_wrong
FLAG_CH8=sk_internal_4c9e1b
FLAG_CH9=cross_tenant_leak_9f2
FLAG_CH10=xss_exfil_confirmed
